# Copy to .env.local for local development and replace placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only credential required by the exam-attempt write API.
# Use a Supabase secret key or legacy service_role key. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
